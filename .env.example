# Web login. Both values are required in production.
PI_WEB_USER=admin
PI_WEB_PASS=replace-with-a-long-random-password

# Keva chat authorization. Model discovery works without it.
KEVA_API_KEY=

# Optional Exa tools.
EXA_API_KEY=

# Initial choices for new application data. Existing user choices are preserved.
PI_WEB_DEFAULT_PROVIDER=keva
PI_WEB_DEFAULT_MODEL=qwen3.8-27b
PI_WEB_DEFAULT_THINKING=high

# Optional: replace the bundled catalog with one-line Pi models.json content.
# PI_WEB_MODELS_JSON={"providers":{"example":{"name":"Example","baseUrl":"https://api.example.com/v1","api":"openai-completions","apiKey":"$EXAMPLE_API_KEY","models":[{"id":"model-id","name":"Model name","reasoning":true,"input":["text"],"contextWindow":131072,"maxTokens":16384}]}}}

# adapter-node's request body cap (default 512K) is too small for image
# attachments; "npm start" needs this raised explicitly. start:sandboxed
# already defaults it to 20M.
# BODY_SIZE_LIMIT=20M

# Abort a run when the model provider streams nothing for this long
# (default 180000 = 3 min, minimum 30000, 0 disables). Raise it if your
# provider legitimately needs longer to produce the first token.
# PI_WEB_STALL_TIMEOUT_MS=180000
