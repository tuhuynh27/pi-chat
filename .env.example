# Web login. Both values are required in production.
PI_WEB_USER=admin
PI_WEB_PASS=replace-with-a-long-random-password

# Bundled Keva models.
KEVA_API_KEY=

# Optional Exa tools.
EXA_API_KEY=

# Initial choices for new application data. Existing user choices are preserved.
PI_WEB_DEFAULT_PROVIDER=keva
PI_WEB_DEFAULT_MODEL=qwen3.6-35b-a3b
PI_WEB_DEFAULT_THINKING=high

# Optional: replace the bundled catalog with one-line Pi models.json content.
# PI_WEB_MODELS_JSON={"providers":{"example":{"name":"Example","baseUrl":"https://api.example.com/v1","api":"openai-completions","apiKey":"$EXAMPLE_API_KEY","models":[{"id":"model-id","name":"Model name","reasoning":true,"input":["text"],"contextWindow":131072,"maxTokens":16384}]}}}
